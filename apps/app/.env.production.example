# ==============================================
# COMPIEL - Variables d'environnement PRODUCTION
# ==============================================
# Copiez ce fichier et configurez-le dans Vercel
# Project Settings → Environment Variables

# ==============================================
# 🔐 AUTHENTICATION
# ==============================================

# Google OAuth (obligatoire)
AUTH_GOOGLE_ID=973201244464-xxx.apps.googleusercontent.com
AUTH_GOOGLE_SECRET=GOCSPX-xxx

# Microsoft OAuth (optionnel)
AUTH_MICROSOFT_CLIENT_ID=
AUTH_MICROSOFT_CLIENT_SECRET=

# GitHub OAuth (optionnel)
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Auth Secrets (générer avec: openssl rand -base64 32)
AUTH_SECRET=CHANGEME_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SECRET_KEY=CHANGEME_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Better Auth URL (IMPORTANT: mettre le bon domaine)
NEXT_PUBLIC_BETTER_AUTH_URL=https://app.compiel.com
BETTER_AUTH_URL=https://app.compiel.com

# Trusted Origins (séparés par virgules)
AUTH_TRUSTED_ORIGINS=https://app.compiel.com,https://portal.compiel.com

# ==============================================
# 🗄️ DATABASE
# ==============================================

# PostgreSQL (Vercel Postgres, Neon, ou Supabase)
DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require

# ==============================================
# 🤖 AI & LLM
# ==============================================

# OpenAI (obligatoire pour l'app)
OPENAI_API_KEY=sk-proj-xxx

# Groq (pour dashboard AI chat)
GROQ_API_KEY=gsk_xxx

# Anthropic Claude (optionnel, plus de choix de modèles)
ANTHROPIC_API_KEY=sk-ant-xxx

# ==============================================
# 📧 EMAIL (Resend)
# ==============================================

RESEND_API_KEY=re_xxx

# ==============================================
# ☁️ AWS S3 (Storage)
# ==============================================

# Pour les pièces jointes et assets
APP_AWS_ACCESS_KEY_ID=AKIA...
APP_AWS_SECRET_ACCESS_KEY=xxx
APP_AWS_REGION=eu-west-3
APP_AWS_BUCKET_NAME=compiel-prod-attachments
APP_AWS_ORG_ASSETS_BUCKET=compiel-prod-org-assets
APP_AWS_QUESTIONNAIRE_UPLOAD_BUCKET=compiel-prod-questionnaires
APP_AWS_KNOWLEDGE_BASE_BUCKET=compiel-prod-knowledge

# ==============================================
# ⚡ TRIGGER.DEV (Async Jobs)
# ==============================================

TRIGGER_SECRET_KEY=tr_prod_xxx
TRIGGER_API_KEY=tr_prod_xxx
TRIGGER_API_URL=https://api.trigger.dev

# ==============================================
# 🔄 REDIS (Upstash - Rate Limiting)
# ==============================================

UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=xxx

# Vector DB (optionnel)
UPSTASH_VECTOR_REST_URL=https://xxx.upstash.io
UPSTASH_VECTOR_REST_TOKEN=xxx

# ==============================================
# 🌐 URLS & DOMAINS
# ==============================================

NEXT_PUBLIC_PORTAL_URL=https://portal.compiel.com
NEXT_PUBLIC_API_URL=https://app.compiel.com

# ==============================================
# 📊 ANALYTICS & TRACKING
# ==============================================

# PostHog
NEXT_PUBLIC_POSTHOG_KEY=phc_xxx
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Google Tag Manager
NEXT_PUBLIC_GTM_ID=GTM-xxx

# LinkedIn Conversions
NEXT_PUBLIC_LINKEDIN_PARTNER_ID=xxx
NEXT_PUBLIC_LINKEDIN_CONVERSION_ID=xxx
LINKEDIN_CONVERSIONS_ACCESS_TOKEN=xxx

# Google Ads
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_LABEL=xxx

# GA4
GA4_API_SECRET=xxx
GA4_MEASUREMENT_ID=G-xxx

# ==============================================
# 🔗 DUB.CO (Link Shortening & Analytics)
# ==============================================

DUB_API_KEY=dub_xxx
DUB_REFER_URL=https://compiel.com
NEXT_PUBLIC_IS_DUB_ENABLED=true

# ==============================================
# 🏢 VERCEL (Trust Portal Domains)
# ==============================================

VERCEL_ACCESS_TOKEN=xxx
VERCEL_TEAM_ID=team_xxx
VERCEL_PROJECT_ID=prj_xxx
NEXT_PUBLIC_VERCEL_URL=compiel.com
TRUST_PORTAL_PROJECT_ID=prj_xxx

# ==============================================
# 🔍 INTEGRATIONS
# ==============================================

# Firecrawl (Vendor Research - obligatoire)
FIRECRAWL_API_KEY=fc-xxx

# Fleet MDM (optionnel)
FLEET_URL=https://your-fleet-instance.com
FLEET_TOKEN=xxx

# Novu (Notifications - optionnel)
NOVU_API_KEY=xxx
NEXT_PUBLIC_NOVU_APPLICATION_IDENTIFIER=xxx

# ==============================================
# 🔐 SECURITY
# ==============================================

# Revalidation Secret (générer avec: openssl rand -base64 32)
REVALIDATION_SECRET=CHANGEME_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ==============================================
# ⚙️ BUILD & DEPLOYMENT
# ==============================================

NODE_ENV=production
NEXT_OUTPUT_STANDALONE=false
